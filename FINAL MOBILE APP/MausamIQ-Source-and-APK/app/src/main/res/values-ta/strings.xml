    <!-- Personas -->
    <string name="persona_student">மாணவர் 🎓</string>
    <string name="persona_student_desc">கல்லூரி பயணம், மழை நேரம் மற்றும் வளாக நிகழ்வுகளுக்கு முன்னுரிமை அளிக்கிறது.</string>
    <string name="persona_farmer">விவசாயி 🌾</string>
    <string name="persona_farmer_desc">மழைப்பொழிவு, ஈரப்பதம், பூச்சிக்கொல்லி தெளிப்புக்கான காற்று வேகம் ஆகியவற்றிற்கு முன்னுரிமை.</string>
    <string name="persona_traveller">பயணி ✈️</string>
    <string name="persona_traveller_desc">நெடுஞ்சாலை பார்வை திறன், காற்று மற்றும் சேருமிட வானிலைக்கு முன்னுரிமை.</string>
    <string name="persona_fitness">உடற்பயிற்சி 🏃</string>
    <string name="persona_fitness_desc">ஓடுதல், உடற்பயிற்சி நேரம், காற்றின் தரம் மற்றும் வெப்பக் குறியீடு.</string>
    <string name="persona_worker">வெளிக்கள பணியாளர் 🦺</string>
    <string name="persona_worker_desc">கடும் வெப்பம், புற ஊதா கதிர் பாதுகாப்பு மற்றும் மின்னல் எச்சரிக்கைகள்.</string>
    <string name="persona_general">பொதுவானது 🌤</string>
    <string name="persona_general_desc">அன்றாட வானிலை மற்றும் குடை எச்சரிக்கைகள்.</string>

